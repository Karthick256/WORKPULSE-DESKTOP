<UserControl x:Class="monitor_desktop.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="Transparent">

    <UserControl.Resources>
        <!-- ── Color Palette (White Theme) ── -->
        <SolidColorBrush x:Key="PageBg"         Color="#F5F7FA"/>
        <SolidColorBrush x:Key="CardBg"         Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentBlue"     Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentBlueHov"  Color="#1D4ED8"/>
        <SolidColorBrush x:Key="AccentTeal"     Color="#0EA5E9"/>
        <SolidColorBrush x:Key="TextDark"       Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSub"        Color="#64748B"/>
        <SolidColorBrush x:Key="TextMuted"      Color="#94A3B8"/>
        <SolidColorBrush x:Key="InputBg"        Color="#F8FAFC"/>
        <SolidColorBrush x:Key="InputBorder"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="ErrorRed"       Color="#DC2626"/>
        <SolidColorBrush x:Key="ErrorBg"        Color="#FEF2F2"/>
        <SolidColorBrush x:Key="ErrorBorder"    Color="#FECACA"/>
        <SolidColorBrush x:Key="SuccessGreen"   Color="#10B981"/>
        <SolidColorBrush x:Key="SuccessBg"      Color="#ECFDF5"/>
        <SolidColorBrush x:Key="SuccessBorder"  Color="#A7F3D0"/>
        <SolidColorBrush x:Key="DividerColor"   Color="#E2E8F0"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#94A3B8" BlurRadius="20" ShadowDepth="0" Opacity="0.10"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#0EA5E9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#2563EB" BlurRadius="12" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="{StaticResource ErrorRed}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#FECACA"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ErrorRed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Messages -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <Border Background="{StaticResource ErrorBg}"
                        BorderBrush="{StaticResource ErrorBorder}" BorderThickness="1"
                        CornerRadius="10" Padding="12,10"
                        Margin="0,0,0,10"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="12" Foreground="{StaticResource ErrorRed}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource ErrorRed}"
                                   FontFamily="Segoe UI"
                                   FontSize="12" TextWrapping="Wrap"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource SuccessBg}"
                        BorderBrush="{StaticResource SuccessBorder}" BorderThickness="1"
                        CornerRadius="10" Padding="12,10"
                        Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" FontSize="12" Foreground="{StaticResource SuccessGreen}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SuccessMessage}"
                                   Foreground="{StaticResource SuccessGreen}"
                                   FontFamily="Segoe UI"
                                   FontSize="12" TextWrapping="Wrap"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Profile Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── Left Column: Avatar + Image Actions + Status ── -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}"
                        Padding="20" Margin="0,0,18,0">
                    <StackPanel>

                        <!-- Avatar ring -->
                        <Border Width="130" Height="130"
                                CornerRadius="65"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#0EA5E9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#2563EB" BlurRadius="20" ShadowDepth="0" Opacity="0.2"/>
                            </Border.Effect>
                            <Border Width="124" Height="124" CornerRadius="62"
                                    Background="{StaticResource CardBg}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Image>
                                    <Image.Source>
                                        <Binding Path="ProfileImage" FallbackValue="/Resources/default-avatar.png"/>
                                    </Image.Source>
                                </Image>
                            </Border>
                        </Border>

                        <!-- Name hint -->
                        <TextBlock Text="{Binding Profile.FirstName}"
                                   FontSize="15" FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextDark}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,2"/>
                        <TextBlock Text="{Binding Profile.Email}"
                                   FontSize="11" FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"
                                   TextWrapping="Wrap"/>

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource DividerColor}" Margin="0,0,0,16"/>

                        <!-- Image Actions -->
                        <TextBlock Text="PHOTO"
                                   FontSize="10" FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextSub}"
                                   Margin="0,0,0,10"/>

                        <Button Content="Upload Photo"
                                Style="{StaticResource PrimaryButton}"
                                Click="UploadPhoto_Click"
                                Margin="0,0,0,8"/>
                        <Button Content="Update Photo"
                                Style="{StaticResource SecondaryButton}"
                                Click="UpdatePhoto_Click"
                                Margin="0,0,0,8"/>
                        <Button Content="Delete Photo"
                                Style="{StaticResource DangerButton}"
                                Click="DeletePhoto_Click"/>

                        <!-- Divider -->
                        <Border Height="1" Background="{StaticResource DividerColor}" Margin="0,20,0,16"/>

                        <!-- Account Status -->
                        <TextBlock Text="ACCOUNT STATUS"
                                   FontSize="10" FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextSub}"
                                   Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Email Verified"
                                       FontSize="12" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextMuted}"
                                       Width="110"/>
                            <TextBlock Text="{Binding Profile.EmailVerified}"
                                       FontSize="12" FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource SuccessGreen}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Status"
                                       FontSize="12" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextMuted}"
                                       Width="110"/>
                            <TextBlock Text="{Binding Profile.Status}"
                                       FontSize="12" FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       Foreground="{StaticResource AccentBlue}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Right Column: Profile Info ── -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Profile Information"
                                   FontSize="18" FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextDark}"
                                   Margin="0,0,0,20"/>

                        <!-- ── VIEW MODE ── -->
                        <StackPanel Visibility="Visible">
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Username"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,10,12"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Profile.Username}"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextDark}" Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="First Name"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,10,12"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Profile.FirstName}"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextDark}" Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Last Name"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,10,12"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Profile.LastName}"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextDark}" Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Email"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,10,12"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Profile.Email}"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextDark}" Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Phone"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,10,12"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Profile.Phone}"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextDark}" Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Street"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,10,12"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Profile.Address.Street}"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextDark}" Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="City"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,10,12"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Profile.Address.City}"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextDark}" Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="State"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,10,12"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Profile.Address.State}"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextDark}" Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Postal Code"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,10,0"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Profile.Address.PostalCode}"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextDark}"/>
                            </Grid>

                            <Button Content="Edit Profile"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="140" HorizontalAlignment="Right"
                                    Click="EditProfile_Click"/>
                        </StackPanel>

                        <!-- ── EDIT MODE ── -->
                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="First Name"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,10,10" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding EditProfile.FirstName}"
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Last Name"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,10,10" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding EditProfile.LastName}"
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Username"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,10,10" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding EditProfile.Username}"
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Email"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,10,10" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="3" Grid.Column="1"
                                         Text="{Binding EditProfile.Email}"
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Phone"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,10,10" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         Text="{Binding EditProfile.Phone}"
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Street"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,10,10" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="5" Grid.Column="1"
                                         Text="{Binding EditProfile.Address.Street}"
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="City"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,10,10" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="6" Grid.Column="1"
                                         Text="{Binding EditProfile.Address.City}"
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="State"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,10,10" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="7" Grid.Column="1"
                                         Text="{Binding EditProfile.Address.State}"
                                         Style="{StaticResource ModernTextBox}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Postal Code"
                                           FontSize="12" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="8" Grid.Column="1"
                                         Text="{Binding EditProfile.Address.PostalCode}"
                                         Style="{StaticResource ModernTextBox}"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel"
                                        Style="{StaticResource SecondaryButton}"
                                        Width="100" Margin="0,0,10,0"
                                        Click="CancelEdit_Click"/>
                                <Button Content="Save Changes"
                                        Style="{StaticResource PrimaryButton}"
                                        Width="130"
                                        Click="SaveProfile_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Loading -->
                        <ProgressBar IsIndeterminate="True"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                     Foreground="{StaticResource AccentBlue}"
                                     Background="Transparent"
                                     Height="2" Margin="0,18,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>