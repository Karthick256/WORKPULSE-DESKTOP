<Window x:Class="monitor_desktop.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Available - WorkPulse"
        Height="500"
        Width="550"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentTeal" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSub" Color="#64748B"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="ErrorRed" Color="#DC2626"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="12" Background="{StaticResource AccentBlue}" Padding="16" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔔" FontSize="28" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="Update Available" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="VersionText" FontSize="12" Foreground="#CCFFFFFF"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" Margin="0,0,0,20">
            <ProgressBar Value="{Binding DownloadProgress}" Height="8" Foreground="{StaticResource AccentBlue}" Background="#E2E8F0" BorderThickness="0"/>
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,0,0,20">
            <DockPanel>
                <TextBlock Text="Release Notes" DockPanel.Dock="Top" Padding="12,10" Background="#F8FAFC" FontWeight="SemiBold" FontSize="13"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <TextBlock x:Name="ReleaseNotesText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSub}"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="InstallButton" Content="Install Now" Click="InstallNow_Click"
                    Padding="20,8" FontSize="13" FontWeight="SemiBold"
                    Cursor="Hand" Background="{StaticResource AccentBlue}" Foreground="White" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="RemindLaterButton" Content="Remind Later" Click="RemindLater_Click"
                    Margin="10,0,0,0" Padding="12,8" FontSize="13"
                    Background="Transparent" BorderBrush="#E2E8F0" BorderThickness="1"
                    Cursor="Hand" Foreground="{StaticResource TextSub}"/>
        </StackPanel>
    </Grid>
</Window>