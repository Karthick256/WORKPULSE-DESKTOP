<Window x:Class="monitor_desktop.Views.BreakSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Start Break"
        Height="560"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBg"      Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PageBg"      Color="#F8FAFC"/>
        <SolidColorBrush x:Key="AccentBlue"  Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentBg"    Color="#EFF6FF"/>
        <SolidColorBrush x:Key="TextDark"    Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSub"     Color="#64748B"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#94A3B8"/>
        <SolidColorBrush x:Key="Divider"     Color="#E2E8F0"/>
        <SolidColorBrush x:Key="InputBg"     Color="#F8FAFC"/>
        <SolidColorBrush x:Key="InputBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="ErrorRed"    Color="#DC2626"/>

        <!-- ── Break option button ── -->
        <Style x:Key="BreakTypeButton" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="{StaticResource TextDark}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Height"          Value="46"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Divider}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter Margin="14,0,14,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"   Value="{StaticResource AccentBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush"  Value="{StaticResource AccentBlue}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Close / window control button ── -->
        <Style x:Key="WinCtrlClose" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Width"           Value="28"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="{StaticResource ErrorRed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Notes TextBox -->
        <Style x:Key="NotesTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource InputBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Foreground"      Value="{StaticResource TextDark}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                <Setter TargetName="Bd" Property="Background"  Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer card -->
    <Border CornerRadius="14" Background="{StaticResource CardBg}" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#94A3B8" BlurRadius="32" ShadowDepth="0" Opacity="0.22"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- Title bar -->
                <RowDefinition Height="52"/>
                <!-- Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Title bar ── -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="{StaticResource Divider}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="20,0,10,0">
                    <!-- Left: icon + title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="7"
                                Background="{StaticResource AccentBg}"
                                Margin="0,0,10,0">
                            <TextBlock Text="☕" FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Take a Break"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource TextDark}"
                                       FontFamily="Segoe UI"/>
                            <TextBlock Text="Select the type of break"
                                       FontSize="10" Foreground="{StaticResource TextMuted}"
                                       FontFamily="Segoe UI"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- Right: close -->
                    <Button x:Name="CloseButton"
                            Content="✕"
                            Style="{StaticResource WinCtrlClose}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- ── Content ── -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource PageBg}">
                <StackPanel Margin="20,20,20,24">

                    <!-- Section label -->
                    <TextBlock Text="BREAK TYPE"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextMuted}"
                               FontFamily="Segoe UI"
                               Margin="0,0,0,10"/>

                    <!-- Break option buttons — each with icon badge + label + hint -->

                    <!-- Lunch -->
                    <Button Style="{StaticResource BreakTypeButton}"
                            Margin="0,0,0,8"
                            Click="BreakType_Click" Tag="LUNCH">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="6"
                                    Background="#FEF9C3" Margin="0,0,12,0">
                                <TextBlock Text="🍽️" FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Lunch Break"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDark}"
                                           FontFamily="Segoe UI"/>
                                <TextBlock Text="Typically 30–60 min"
                                           FontSize="10" Foreground="{StaticResource TextMuted}"
                                           FontFamily="Segoe UI"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Short Break -->
                    <Button Style="{StaticResource BreakTypeButton}"
                            Margin="0,0,0,8"
                            Click="BreakType_Click" Tag="SHORT_BREAK">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="6"
                                    Background="#ECFDF5" Margin="0,0,12,0">
                                <TextBlock Text="☕" FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Short Break"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDark}"
                                           FontFamily="Segoe UI"/>
                                <TextBlock Text="5 – 10 minutes"
                                           FontSize="10" Foreground="{StaticResource TextMuted}"
                                           FontFamily="Segoe UI"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Long Break -->
                    <Button Style="{StaticResource BreakTypeButton}"
                            Margin="0,0,0,8"
                            Click="BreakType_Click" Tag="LONG_BREAK">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="6"
                                    Background="#F0FDF4" Margin="0,0,12,0">
                                <TextBlock Text="🌿" FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Long Break"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDark}"
                                           FontFamily="Segoe UI"/>
                                <TextBlock Text="15 – 30 minutes"
                                           FontSize="10" Foreground="{StaticResource TextMuted}"
                                           FontFamily="Segoe UI"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Meeting -->
                    <Button Style="{StaticResource BreakTypeButton}"
                            Margin="0,0,0,8"
                            Click="BreakType_Click" Tag="MEETING">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="6"
                                    Background="#EFF6FF" Margin="0,0,12,0">
                                <TextBlock Text="👥" FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Meeting"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDark}"
                                           FontFamily="Segoe UI"/>
                                <TextBlock Text="Team or client meeting"
                                           FontSize="10" Foreground="{StaticResource TextMuted}"
                                           FontFamily="Segoe UI"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Training -->
                    <Button Style="{StaticResource BreakTypeButton}"
                            Margin="0,0,0,8"
                            Click="BreakType_Click" Tag="TRAINING">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="6"
                                    Background="#FAF5FF" Margin="0,0,12,0">
                                <TextBlock Text="📚" FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Training Session"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDark}"
                                           FontFamily="Segoe UI"/>
                                <TextBlock Text="Learning or onboarding"
                                           FontSize="10" Foreground="{StaticResource TextMuted}"
                                           FontFamily="Segoe UI"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Personal -->
                    <Button Style="{StaticResource BreakTypeButton}"
                            Margin="0,0,0,0"
                            Click="BreakType_Click" Tag="PERSONAL">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28" Height="28" CornerRadius="6"
                                    Background="#FFF1F2" Margin="0,0,12,0">
                                <TextBlock Text="💚" FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Personal Break"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDark}"
                                           FontFamily="Segoe UI"/>
                                <TextBlock Text="Personal errand or wellness"
                                           FontSize="10" Foreground="{StaticResource TextMuted}"
                                           FontFamily="Segoe UI"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Divider -->
                    <Rectangle Height="1" Fill="{StaticResource Divider}" Margin="0,20,0,16"/>

                    <!-- Notes -->
                    <TextBlock Text="NOTES"
                               FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextMuted}"
                               FontFamily="Segoe UI"
                               Margin="0,0,0,8"/>
                    <TextBox x:Name="NotesBox"
                             Height="68"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Style="{StaticResource NotesTextBox}"/>
                    <TextBlock Text="Optional — add any relevant context"
                               FontSize="10" Foreground="{StaticResource TextMuted}"
                               FontFamily="Segoe UI" Margin="0,4,0,0"/>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</Window>
