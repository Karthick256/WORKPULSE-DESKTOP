<UserControl x:Class="monitor_desktop.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:monitor_desktop.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="Transparent">

    <UserControl.Resources>
        <!-- ── Color Palette (White Theme) ── -->
        <SolidColorBrush x:Key="PageBg"         Color="#F5F7FA"/>
        <SolidColorBrush x:Key="CardBg"         Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentBlue"     Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentBlueHov"  Color="#1D4ED8"/>
        <SolidColorBrush x:Key="AccentTeal"     Color="#0EA5E9"/>
        <SolidColorBrush x:Key="TextDark"       Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSub"        Color="#64748B"/>
        <SolidColorBrush x:Key="TextMuted"      Color="#94A3B8"/>
        <SolidColorBrush x:Key="InputBg"        Color="#F8FAFC"/>
        <SolidColorBrush x:Key="InputBorder"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="ErrorRed"       Color="#DC2626"/>
        <SolidColorBrush x:Key="ErrorBg"        Color="#FEF2F2"/>
        <SolidColorBrush x:Key="ErrorBorder"    Color="#FECACA"/>
        <SolidColorBrush x:Key="SuccessGreen"   Color="#10B981"/>
        <SolidColorBrush x:Key="SuccessBg"      Color="#ECFDF5"/>
        <SolidColorBrush x:Key="SuccessBorder"  Color="#A7F3D0"/>
        <SolidColorBrush x:Key="WarningYellow"  Color="#F59E0B"/>
        <SolidColorBrush x:Key="WarningBg"      Color="#FFFBEB"/>
        <SolidColorBrush x:Key="WarningBorder"  Color="#FDE68A"/>
        <SolidColorBrush x:Key="DividerColor"   Color="#E2E8F0"/>
        <SolidColorBrush x:Key="PanelBg"        Color="#EFF6FF"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolConverter       x:Key="InverseBoolConverter"/>
        <converters:SessionStatusColorConverter x:Key="StatusColorConverter"/>
        <converters:MinutesToStringConverter   x:Key="MinutesConverter"/>
        <converters:ScoreToColorConverter      x:Key="ScoreColorConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:StatusToStringConverter    x:Key="StatusConverter"/>
        <converters:StatusToColorConverter     x:Key="ColorConverter"/>

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#94A3B8" BlurRadius="20" ShadowDepth="0" Opacity="0.10"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#0EA5E9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#2563EB" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success / Check-In button -->
        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="#10B981">
                            <Border.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="12" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger / Check-Out button -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="#DC2626">
                            <Border.Effect>
                                <DropShadowEffect Color="#DC2626" BlurRadius="12" ShadowDepth="0" Opacity="0.25"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DatePicker Style -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <DatePickerTextBox x:Name="PART_TextBox"
                                               Foreground="{TemplateBinding Foreground}"
                                               Background="Transparent"
                                               BorderThickness="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Status bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource PanelBg}"
                    CornerRadius="10" Padding="12,10"
                    Margin="0,0,0,16"
                    BorderBrush="{StaticResource InputBorder}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ" FontSize="14"
                               Foreground="{StaticResource AccentBlue}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource TextSub}" FontFamily="Segoe UI"
                               FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Two-column layout -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ══ LEFT: Current Session Card ══ -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,18,0">
                    <StackPanel>

                        <!-- Icon -->
                        <Border Width="60" Height="60" CornerRadius="16"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#0EA5E9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#2563EB" BlurRadius="16" ShadowDepth="0" Opacity="0.25"/>
                            </Border.Effect>
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="24" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Title -->
                        <TextBlock Text="Current Session"
                                   FontSize="16" FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextDark}"
                                   HorizontalAlignment="Center" Margin="0,0,0,16"/>

                        <!-- Status badge -->
                        <Border CornerRadius="20" Padding="10,5" Margin="0,0,0,20"
                                HorizontalAlignment="Center" Background="{StaticResource InputBg}">
                            <TextBlock
                                Text="{Binding IsCheckedIn, Converter={StaticResource StatusConverter},
                                       ConverterParameter='● ACTIVE|● INACTIVE'}"
                                FontSize="11" FontWeight="Bold"
                                Foreground="{Binding IsCheckedIn, Converter={StaticResource ColorConverter},
                                             ConverterParameter='#10B981|#DC2626'}"
                                HorizontalAlignment="Center"/>
                        </Border>

                        <!-- Session details grid -->
                        <StackPanel Margin="0,0,0,20">

                            <!-- Check-in time -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Check In:"
                                           FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentSession.CheckInTime,
                                                  StringFormat=HH:mm:ss, TargetNullValue='—'}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDark}"/>
                            </Grid>

                            <!-- Live duration (only while active) -->
                            <Grid Margin="0,0,0,10"
                                  Visibility="{Binding IsCheckedIn, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Duration:"
                                           FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SessionDuration}"
                                           FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBlue}"/>
                            </Grid>

                            <!-- Workstation -->
                            <Grid Margin="0,0,0,10"
                                  Visibility="{Binding CurrentSession.WorkstationName,
                                               Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Workstation:"
                                           FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentSession.WorkstationName}"
                                           FontSize="12" Foreground="{StaticResource TextDark}"
                                           TextWrapping="Wrap"/>
                            </Grid>

                            <!-- IP -->
                            <Grid Visibility="{Binding CurrentSession.IpAddress,
                                               Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="IP Address:"
                                           FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentSession.IpAddress}"
                                           FontSize="12" Foreground="{StaticResource TextDark}"/>
                            </Grid>
                        </StackPanel>

                        <Button Content="{Binding CheckInButtonText}"
                                Command="{Binding CheckInCommand}"
                                Style="{StaticResource SuccessButton}"
                                IsEnabled="{Binding CanCheckIn}"
                                Margin="0,0,0,10"/>

                        <Button Content="{Binding CheckOutButtonText}"
                                Command="{Binding CheckOutCommand}"
                                Style="{StaticResource DangerButton}"
                                IsEnabled="{Binding CanCheckOut}"
                                Margin="0,0,0,10"/>


                        <!-- Loading bar -->
                        <ProgressBar IsIndeterminate="True"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                     Foreground="{StaticResource AccentBlue}"
                                     Background="Transparent"
                                     Height="2" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ══ RIGHT: Session History ══ -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Session History"
                                   FontSize="16" FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextDark}"
                                   Margin="0,0,0,16"/>

                        <!-- Filter Controls -->
                        <Border Background="{StaticResource InputBg}" CornerRadius="10" Padding="12" Margin="0,0,0,16"
                                BorderBrush="{StaticResource InputBorder}" BorderThickness="1">
                            <StackPanel>

                                <!-- Tab row -->
                                <WrapPanel Margin="0,0,0,12">
                                    <RadioButton Content="Today"
                                                 IsChecked="{Binding IsTodaySelected}"
                                                 GroupName="FilterType"
                                                 Foreground="{StaticResource TextSub}"
                                                 Margin="0,0,15,0"/>
                                    <RadioButton Content="By Date"
                                                 IsChecked="{Binding IsByDateSelected}"
                                                 GroupName="FilterType"
                                                 Foreground="{StaticResource TextSub}"
                                                 Margin="0,0,15,0"/>
                                    <RadioButton Content="Date Range"
                                                 IsChecked="{Binding IsDateRangeSelected}"
                                                 GroupName="FilterType"
                                                 Foreground="{StaticResource TextSub}"
                                                 Margin="0,0,15,0"/>
                                    <RadioButton Content="Admin View"
                                                 IsChecked="{Binding IsAdminViewSelected}"
                                                 GroupName="FilterType"
                                                 Foreground="{StaticResource TextSub}"
                                                 Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                                </WrapPanel>

                                <!-- Today panel -->
                                <StackPanel Visibility="{Binding IsTodaySelected, Converter={StaticResource BoolToVis}}">
                                    <Button Content="↻  Reload Today"
                                            Command="{Binding LoadTodaySessionsCommand}"
                                            Style="{StaticResource PrimaryButton}"/>
                                </StackPanel>

                                <!-- By date -->
                                <StackPanel Visibility="{Binding IsByDateSelected, Converter={StaticResource BoolToVis}}">
                                    <DatePicker SelectedDate="{Binding SelectedDate}"
                                                Margin="0,0,0,10" Height="35"
                                                Style="{StaticResource ModernDatePicker}"/>
                                    <Button Content="Load Sessions"
                                            Command="{Binding LoadByDateCommand}"
                                            Style="{StaticResource PrimaryButton}"/>
                                </StackPanel>

                                <!-- Date range -->
                                <StackPanel Visibility="{Binding IsDateRangeSelected, Converter={StaticResource BoolToVis}}">
                                    <DatePicker SelectedDate="{Binding DateRangeFrom}"
                                                Margin="0,0,0,8" Height="35"
                                                Style="{StaticResource ModernDatePicker}"/>
                                    <DatePicker SelectedDate="{Binding DateRangeTo}"
                                                Margin="0,0,0,10" Height="35"
                                                Style="{StaticResource ModernDatePicker}"/>
                                    <Button Content="Load Sessions"
                                            Command="{Binding LoadByRangeCommand}"
                                            Style="{StaticResource PrimaryButton}"/>
                                </StackPanel>

                                <!-- Admin view -->
                                <StackPanel Visibility="{Binding IsAdminViewSelected, Converter={StaticResource BoolToVis}}">
                                    <DatePicker SelectedDate="{Binding DateRangeFrom}"
                                                Margin="0,0,0,8" Height="35"
                                                Style="{StaticResource ModernDatePicker}"/>
                                    <DatePicker SelectedDate="{Binding DateRangeTo}"
                                                Margin="0,0,0,10" Height="35"
                                                Style="{StaticResource ModernDatePicker}"/>
                                    <Button Content="Load All Employees"
                                            Command="{Binding LoadAdminViewCommand}"
                                            Style="{StaticResource PrimaryButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Session list -->
                        <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Sessions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource InputBg}" CornerRadius="10"
                                                Padding="12" Margin="0,0,0,8"
                                                BorderBrush="{StaticResource InputBorder}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Status dot -->
                                                <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                                                        Background="{Binding SessionStatus,
                                                                     Converter={StaticResource StatusColorConverter}}"
                                                        VerticalAlignment="Center" Margin="0,0,12,0"/>

                                                <!-- Info -->
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextDark}">
                                                        <Run Text="{Binding WorkDate, StringFormat='{}{0:MMM dd, yyyy}'}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding CheckInTime, StringFormat='{}{0:HH:mm}'}"/>
                                                        <Run Text=" — "/>
                                                        <Run Text="{Binding CheckOutTime,
                                                                    StringFormat='{}{0:HH:mm}',
                                                                    TargetNullValue='Active'}"/>
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}">
                                                            <Run Text="Duration: "/>
                                                            <Run Text="{Binding TotalSessionMinutes,
                                                                        Converter={StaticResource MinutesConverter}}"/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}"
                                                                   Margin="12,0,0,0">
                                                            <Run Text="Active: "/>
                                                            <Run Text="{Binding TotalActiveMinutes,
                                                                        Converter={StaticResource MinutesConverter}}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}"
                                                               Margin="0,2,0,0"
                                                               Text="{Binding WorkstationName}"/>
                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}"
                                                               Text="{Binding Username}"
                                                               Visibility="{Binding DataContext.IsAdminViewSelected,
                                                                   RelativeSource={RelativeSource FindAncestor,
                                                                       AncestorType=UserControl},
                                                                   Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>

                                                <!-- Score badge -->
                                                <Border Grid.Column="2" CornerRadius="8" Padding="8,4"
                                                        Background="{StaticResource PanelBg}" VerticalAlignment="Center">
                                                    <TextBlock FontSize="12" FontWeight="Bold"
                                                               Foreground="{Binding ProductivityScore,
                                                                            Converter={StaticResource ScoreColorConverter}}">
                                                        <Run Text="{Binding ProductivityScore, StringFormat=F0}"/>
                                                        <Run Text="%"/>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" Margin="0,24,0,0"
                                    Visibility="{Binding Sessions.Count,
                                                 Converter={StaticResource CountToVisibilityConverter},
                                                 ConverterParameter=0}">
                            <TextBlock Text="📋" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="No sessions found"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Check in to start tracking, or pick a different date."
                                       FontSize="11" Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>