<UserControl x:Class="monitor_desktop.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentTeal" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSub" Color="#64748B"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="InputBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="InputBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="ErrorRed" Color="#DC2626"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#94A3B8" BlurRadius="20" ShadowDepth="0" Opacity="0.10"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="#10B981">
                            <Border.Effect>
                                <DropShadowEffect Color="#10B981" BlurRadius="12" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="#DC2626">
                            <Border.Effect>
                                <DropShadowEffect Color="#DC2626" BlurRadius="12" ShadowDepth="0" Opacity="0.25"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#CBD5E1"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#EFF6FF" CornerRadius="10" Padding="12,10" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ℹ" FontSize="14" Foreground="#2563EB" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="30" HorizontalAlignment="Center" Width="400">
            <StackPanel>
                <Border Width="60" Height="60" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2563EB" Offset="0"/>
                            <GradientStop Color="#0EA5E9" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#2563EB" BlurRadius="16" ShadowDepth="0" Opacity="0.25"/>
                    </Border.Effect>
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Current Session" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextDark}" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <Border CornerRadius="20" Padding="10,5" Margin="0,0,0,20" HorizontalAlignment="Center" Background="{StaticResource InputBg}">
                    <TextBlock FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="● INACTIVE"/>
                                <Setter Property="Foreground" Value="#DC2626"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCheckedIn}" Value="True">
                                        <Setter Property="Text" Value="● ACTIVE"/>
                                        <Setter Property="Foreground" Value="#10B981"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <StackPanel Margin="0,0,0,20">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Check In:" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentSession.CheckInTime, StringFormat=HH:mm:ss, TargetNullValue='—'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDark}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10" Visibility="{Binding IsCheckedIn, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Duration:" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="{Binding SessionDuration}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBlue}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10" Visibility="{Binding CurrentSession.WorkstationName, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Workstation:" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentSession.WorkstationName}" FontSize="12" Foreground="{StaticResource TextDark}" TextWrapping="Wrap"/>
                    </Grid>

                    <Grid Visibility="{Binding CurrentSession.IpAddress, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="IP Address:" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentSession.IpAddress}" FontSize="12" Foreground="{StaticResource TextDark}"/>
                    </Grid>
                </StackPanel>

                <Button Content="{Binding CheckInButtonText}" Command="{Binding CheckInCommand}" Style="{StaticResource SuccessButton}" IsEnabled="{Binding CanCheckIn}" Margin="0,0,0,10"/>
                <Button Content="{Binding CheckOutButtonText}" Command="{Binding CheckOutCommand}" Style="{StaticResource DangerButton}" IsEnabled="{Binding CanCheckOut}" Margin="0,0,0,10"/>
                <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Foreground="{StaticResource AccentBlue}" Background="Transparent" Height="2" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>