<Window x:Class="monitor_desktop.Views.ForgotUsernameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forgot Username"
        Height="480"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- ── Color Palette (White Theme) ── -->
        <SolidColorBrush x:Key="PageBg"         Color="#F5F7FA"/>
        <SolidColorBrush x:Key="CardBg"         Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentBlue"     Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentBlueHov"  Color="#1D4ED8"/>
        <SolidColorBrush x:Key="AccentTeal"     Color="#0EA5E9"/>
        <SolidColorBrush x:Key="TextDark"       Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSub"        Color="#64748B"/>
        <SolidColorBrush x:Key="TextMuted"      Color="#94A3B8"/>
        <SolidColorBrush x:Key="InputBg"        Color="#F8FAFC"/>
        <SolidColorBrush x:Key="InputBorder"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="ErrorRed"       Color="#DC2626"/>
        <SolidColorBrush x:Key="ErrorBg"        Color="#FEF2F2"/>
        <SolidColorBrush x:Key="ErrorBorder"    Color="#FECACA"/>
        <SolidColorBrush x:Key="SuccessGreen"   Color="#10B981"/>
        <SolidColorBrush x:Key="SuccessBg"      Color="#ECFDF5"/>
        <SolidColorBrush x:Key="SuccessBorder"  Color="#A7F3D0"/>
        <SolidColorBrush x:Key="DividerColor"   Color="#E2E8F0"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ── Input TextBox ── -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- ── Primary Button ── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#0EA5E9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#2563EB" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Secondary Button ── -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Close Button ── -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="{StaticResource ErrorRed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ── Outer Shell ── -->
    <Border CornerRadius="18">
        <Border.Background>
            <SolidColorBrush Color="#F5F7FA"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#94A3B8" BlurRadius="40" ShadowDepth="0" Opacity="0.25"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Custom Title Bar ── -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseDown" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Ellipse Width="11" Height="11" Fill="#FC5F57" Margin="0,0,6,0"/>
                    <Ellipse Width="11" Height="11" Fill="#FDBC40" Margin="0,0,6,0"/>
                    <Ellipse Width="11" Height="11" Fill="#33C748"/>
                </StackPanel>
                <TextBlock Text="WorkPulse"
                           FontSize="12" FontFamily="Segoe UI" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Content="✕"
                        Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Right"
                        Margin="0,0,8,0"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- ── Content ── -->
            <Border Grid.Row="1"
                    Background="{StaticResource CardBg}"
                    CornerRadius="14"
                    Margin="24,0,24,24">
                <Border.Effect>
                    <DropShadowEffect Color="#94A3B8" BlurRadius="20" ShadowDepth="0" Opacity="0.10"/>
                </Border.Effect>

                <StackPanel Margin="36,32,36,32" VerticalAlignment="Top">

                    <!-- Icon -->
                    <Border Width="64" Height="64" CornerRadius="16"
                            HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2563EB" Offset="0"/>
                                <GradientStop Color="#0EA5E9" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="#2563EB" BlurRadius="16" ShadowDepth="0" Opacity="0.25"/>
                        </Border.Effect>
                        <TextBlock Text="🔐" FontSize="26"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="White"/>
                    </Border>

                    <TextBlock Text="Forgot Username?"
                               FontSize="22" FontWeight="Bold"
                               FontFamily="Segoe UI"
                               Foreground="{StaticResource TextDark}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Enter your email address and we'll send your username to you"
                               FontSize="13" FontFamily="Segoe UI"
                               Foreground="{StaticResource TextSub}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,28"/>

                    <!-- Divider -->
                    <Grid Margin="0,0,0,24">
                        <Rectangle Height="1" Fill="{StaticResource DividerColor}" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Center" Background="White" Padding="10,0">
                            <TextBlock Text="Account Recovery"
                                       FontSize="11" FontFamily="Segoe UI"
                                       Foreground="{StaticResource TextMuted}"/>
                        </Border>
                    </Grid>

                    <!-- Email -->
                    <TextBlock Text="EMAIL ADDRESS"
                               FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                               Foreground="{StaticResource TextSub}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="EmailBox"
                             Style="{StaticResource ModernTextBox}"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,20"/>

                    <!-- Success Banner -->
                    <Border Background="{StaticResource SuccessBg}"
                            BorderBrush="{StaticResource SuccessBorder}"
                            BorderThickness="1"
                            CornerRadius="8" Padding="12,10"
                            Margin="0,0,0,16"
                            Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✓" FontSize="12" Foreground="{StaticResource SuccessGreen}" VerticalAlignment="Center"/>
                            <TextBlock Text="Username recovery email sent! Please check your inbox."
                                       Foreground="{StaticResource SuccessGreen}"
                                       FontSize="12" FontFamily="Segoe UI"
                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Error Banner -->
                    <Border Background="{StaticResource ErrorBg}"
                            BorderBrush="{StaticResource ErrorBorder}"
                            BorderThickness="1"
                            CornerRadius="8" Padding="12,10"
                            Margin="0,0,0,16"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="12" Foreground="{StaticResource ErrorRed}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{StaticResource ErrorRed}"
                                       FontSize="12" FontFamily="Segoe UI"
                                       TextWrapping="Wrap"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Button Content="Cancel"
                                Style="{StaticResource SecondaryButton}"
                                Width="110" Margin="0,0,12,0"
                                Click="Cancel_Click"/>
                        <Button Content="Send Recovery Email"
                                Style="{StaticResource PrimaryButton}"
                                Width="160"
                                Click="Recover_Click"/>
                    </StackPanel>

                    <!-- Loading -->
                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                 Foreground="{StaticResource AccentBlue}"
                                 Background="Transparent"
                                 Height="2" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>