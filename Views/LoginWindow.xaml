<Window x:Class="monitor_desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Employee Portal"
        Height="580"
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- ── Color Palette (White Theme) ── -->
        <SolidColorBrush x:Key="PageBg"         Color="#F5F7FA"/>
        <SolidColorBrush x:Key="CardBg"         Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentBlue"     Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentBlueHov"  Color="#1D4ED8"/>
        <SolidColorBrush x:Key="AccentTeal"     Color="#0EA5E9"/>
        <SolidColorBrush x:Key="TextDark"       Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSub"        Color="#64748B"/>
        <SolidColorBrush x:Key="TextMuted"      Color="#94A3B8"/>
        <SolidColorBrush x:Key="InputBg"        Color="#F8FAFC"/>
        <SolidColorBrush x:Key="InputBorder"    Color="#E2E8F0"/>
        <SolidColorBrush x:Key="ErrorRed"       Color="#DC2626"/>
        <SolidColorBrush x:Key="ErrorBg"        Color="#FEF2F2"/>
        <SolidColorBrush x:Key="ErrorBorder"    Color="#FECACA"/>
        <SolidColorBrush x:Key="PanelBg"        Color="#EFF6FF"/>
        <SolidColorBrush x:Key="DividerColor"   Color="#E2E8F0"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ── Input TextBox ── -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBlue}"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- ── PasswordBox ── -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- ── Link Button── -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelBg}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBlueHov}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary Button ── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#0EA5E9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#2563EB" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.90"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Close Button ── -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="{StaticResource ErrorRed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ── Outer Shell ── -->
    <Border CornerRadius="18">
        <Border.Background>
            <SolidColorBrush Color="#F5F7FA"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#94A3B8" BlurRadius="40" ShadowDepth="0" Opacity="0.25"/>
        </Border.Effect>

        <!-- Two-column split layout -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Custom Title Bar ── -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseDown" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <!-- Three macOS-style dots for decorative polish -->
                    <Ellipse Width="11" Height="11" Fill="#FC5F57" Margin="0,0,6,0"/>
                    <Ellipse Width="11" Height="11" Fill="#FDBC40" Margin="0,0,6,0"/>
                    <Ellipse Width="11" Height="11" Fill="#33C748"/>
                </StackPanel>
                <TextBlock Text="WorkPulse"
                           FontSize="12" FontFamily="Segoe UI" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Content="✕"
                        Style="{StaticResource CloseButton}"
                        HorizontalAlignment="Right"
                        Margin="0,0,8,0"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- ── Body: Left panel + Right form ── -->
            <Grid Grid.Row="1" Margin="24,0,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ════ LEFT PANEL: Brand / Illustration ════ -->
                <Border Grid.Column="0"
                        CornerRadius="14"
                        ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2563EB" Offset="0"/>
                            <GradientStop Color="#0EA5E9" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <!-- Subtle top-right circle decoration -->
                        <Ellipse Width="220" Height="220"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,-70,-70,0"
                                 Opacity="0.18">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#FFFFFF"/>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Subtle bottom-left circle decoration -->
                        <Ellipse Width="160" Height="160"
                                 HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                 Margin="-50,0,0,-50"
                                 Opacity="0.12">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#FFFFFF"/>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- Dot grid pattern (purely decorative, subtle) -->
                        <ItemsControl HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="0,0,0,80" Opacity="0.10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="5" Columns="7"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                            <Ellipse Width="5" Height="5" Fill="White" Margin="6"/>
                        </ItemsControl>

                        <!-- Brand content -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">

                            <!-- Icon ring -->
                            <Border Width="72" Height="72" CornerRadius="20"
                                    HorizontalAlignment="Center" Margin="0,0,0,24"
                                    Background="#26FFFFFF">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.15"/>
                                </Border.Effect>
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="30" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="WorkPulse"
                                       FontSize="26" FontWeight="Bold" FontFamily="Segoe UI"
                                       Foreground="White" HorizontalAlignment="Center"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Smart employee activities&#x0a;and productivity."
                                       FontSize="13" FontFamily="Segoe UI"
                                       Foreground="#CCFFFFFF"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       LineHeight="20"
                                       Margin="0,0,0,32"/>

                            <!-- Three feature chips -->
                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,8">
                                <Border CornerRadius="20" Background="#26FFFFFF" Padding="14,7" Margin="0,0,0,8" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Text="  Smart Productivity" FontSize="12" FontFamily="Segoe UI" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="20" Background="#26FFFFFF" Padding="14,7" Margin="0,0,0,8" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Text="  Secure &amp; Private" FontSize="12" FontFamily="Segoe UI" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="20" Background="#26FFFFFF" Padding="14,7" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Text="  Smart Analytics" FontSize="12" FontFamily="Segoe UI" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Bottom tag -->
                        <TextBlock Text="© 2026 AAPL"
                                   FontSize="11" FontFamily="Segoe UI"
                                   Foreground="#80FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                   Margin="0,0,0,16"/>
                    </Grid>
                </Border>

                <!-- ════ RIGHT PANEL: Login Form ════ -->
                <Border Grid.Column="2"
                        CornerRadius="14"
                        Background="{StaticResource CardBg}">
                    <Border.Effect>
                        <DropShadowEffect Color="#94A3B8" BlurRadius="20" ShadowDepth="0" Opacity="0.10"/>
                    </Border.Effect>

                    <StackPanel VerticalAlignment="Center" Margin="36,32,36,32">

                        <!-- Greeting -->
                        <TextBlock Text="Welcome back"
                                   FontSize="22" FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextDark}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Sign in to your account"
                                   FontSize="13" FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextSub}"
                                   Margin="0,0,0,28"/>

                        <!-- Divider line with label -->
                        <Grid Margin="0,0,0,24">
                            <Rectangle Height="1" Fill="{StaticResource DividerColor}" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Center" Background="White" Padding="10,0">
                                <TextBlock Text="Enter your credentials"
                                           FontSize="11" FontFamily="Segoe UI"
                                           Foreground="{StaticResource TextMuted}"/>
                            </Border>
                        </Grid>

                        <!-- Username -->
                        <TextBlock Text="USERNAME"
                                   FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextSub}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="UsernameBox"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,16"/>

                        <!-- Password -->
                        <TextBlock Text="PASSWORD"
                                   FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextSub}"
                                   Margin="0,0,0,6"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource ModernPasswordBox}"
                                     Margin="0,0,0,10"/>

                        <!-- Forgot links -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
                            <Button x:Name="ForgotUsernameBtn" Content="Forgot Username?"
                                    Style="{StaticResource LinkButton}" Click="ForgotUsername_Click"/>
                            <TextBlock Text="  ·  "
                                       Foreground="{StaticResource InputBorder}"
                                       VerticalAlignment="Center" FontSize="12"/>
                            <Button x:Name="ForgotPasswordBtn" Content="Forgot Password?"
                                    Style="{StaticResource LinkButton}" Click="ForgotPassword_Click"/>
                        </StackPanel>

                        <!-- Error Banner -->
                        <Border Background="{StaticResource ErrorBg}"
                                BorderBrush="{StaticResource ErrorBorder}"
                                BorderThickness="1"
                                CornerRadius="8" Padding="12,10"
                                Margin="0,0,0,14"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" FontSize="12"
                                           Foreground="{StaticResource ErrorRed}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="{StaticResource ErrorRed}"
                                           FontSize="12" TextWrapping="Wrap"
                                           FontFamily="Segoe UI"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Sign In Button -->
                        <Button x:Name="LoginButton"
                                Content="Sign In"
                                IsDefault="True"
                                Click="LoginButton_Click"
                                Style="{StaticResource PrimaryButton}"/>

                        <!-- Loading Bar -->
                        <ProgressBar IsIndeterminate="True"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                     Height="2" Margin="0,10,0,0"
                                     Background="Transparent"
                                     Foreground="{StaticResource AccentBlue}"/>

                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>